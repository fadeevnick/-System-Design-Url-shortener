---
compose_dir: /opt/url-shortener
compose_replicas: 2
image_uri: 075483720790.dkr.ecr.eu-central-1.amazonaws.com/url-shortener:replace-me
pg_pool_max: 20
aws_region: eu-central-1
database_secret_arn: arn:aws:secretsmanager:eu-central-1:ACCOUNT_ID:secret:url-shortener/database

# For non-AWS deployments, keep DATABASE_URL in Ansible Vault or inject it
# from the cloud provider's secret manager instead of committing it here.
# database_url: "postgres://user:password@host:5432/database"

# Set registry_type=aws_ecr when the VM has an AWS instance profile.
# For another cloud, use registry_type=generic and provide credentials through
# Ansible Vault or environment variables, never commit them here.
registry_type: aws_ecr
registry_server: 075483720790.dkr.ecr.eu-central-1.amazonaws.com
